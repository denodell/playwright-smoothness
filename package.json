{
  "name": "playwright-smoothness",
  "version": "1.0.0",
  "description": "Fail the build when a web UI stops being smooth. Frame, input and long-list checks for Playwright, compared against a baseline.",
  "license": "MIT",
  "author": "Den Odell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denodell/playwright-smoothness.git"
  },
  "homepage": "https://github.com/denodell/playwright-smoothness#readme",
  "bugs": {
    "url": "https://github.com/denodell/playwright-smoothness/issues"
  },
  "keywords": [
    "playwright",
    "performance",
    "jank",
    "smoothness",
    "long-animation-frames",
    "event-timing"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/reporter.d.ts",
        "default": "./dist/reporter.js"
      },
      "require": {
        "types": "./dist/reporter.d.cts",
        "default": "./dist/reporter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-smoothness": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:detection",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration --project=integration-firefox --project=e2e",
    "test:detection": "playwright test --project=detection",
    "test:headless-modes": "playwright test --project=mode-headless-shell --project=mode-new-headless --project=mode-headed",
    "changeset": "changeset",
    "prepublishOnly": "npm run build",
    "release:check": "npm run build && npm publish --dry-run",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  },
  "devDependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "zone.js": "0.16.3"
  }
}
